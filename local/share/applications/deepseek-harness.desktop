[Desktop Entry]
Name=DeepSeek Harness
# Chromium 152 的 FontDataServiceLinux:renderer 排版时同步向浏览器进程查字体,偶发永不返回,界面永久冻结
Exec=/opt/dsh-desktop-linux-bin/deepseek-harness --disable-features=FontDataServiceLinux %U
Terminal=false
Type=Application
Icon=deepseek-harness
StartupWMClass=deepseek-harness
Comment=Electron desktop shell for a bundled dsh runtime and external plugins
MimeType=x-scheme-handler/dsh;
Categories=Development;
