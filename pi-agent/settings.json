{
  "lastChangelogVersion": "0.85.1",
  "defaultProvider": "sub2api-openai",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-web-access",
    "npm:pi-tps",
    "npm:@tintinweb/pi-subagents",
    "npm:@tintinweb/pi-tasks",
    "npm:@aliou/pi-processes",
    "npm:@mrclrchtr/supi-context",
    "npm:pi-schedule-prompt",
    "https://github.com/sjet47/pi-setup",
    "https://github.com/sjet47/pi-intercom",
    "npm:pi-mcp-adapter",
    "npm:pi-compact-ui"
  ],
  "npmCommand": [
    "npm",
    "--allow-remote=all"
  ],
  "enabledModels": [
    "sub2api-openai/gpt-5.6-sol",
    "sub2api-grok/grok-4.6",
    "sub2api-openai/kimi-k3",
    "sub2api-openai/GLM-5.3-Flash",
    "sub2api-openai/grok-4.6",
    "sub2api-openai/gpt-6-astra",
    "sub2api-openai/deepseek-flash"
  ],
  "enableInstallTelemetry": false,
  "hideThinkingBlock": true,
  "showHardwareCursor": true,
  "editorPaddingX": 1,
  "collapseChangelog": true,
  "treeFilterMode": "user-only",
  "compaction": {
    "enabled": true
  },
  "theme": "dark",
  "pi-multicodex": {
    "usageMode": "left",
    "resetWindow": "7d",
    "showAccount": true,
    "showReset": false,
    "order": "account-first"
  },
  "powerline": {
    "preset": "default",
    "mouseScroll": true,
    "fixedEditor": true
  },
  "workingVibe": "startrek",
  "workingVibeMode": "file",
  "terminal": {
    "showTerminalProgress": true
  },
  "transport": "auto",
  "quietStartup": false,
  "doubleEscapeAction": "tree",
  "images": {
    "autoResize": false
  },
  "showCacheMissNotices": false,
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "always",
  "fullscreenExitOutput": "resume-hint",
  "outputPad": 1,
  "defaultProjectTrust": "always"
}