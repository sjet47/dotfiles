{
  "lastChangelogVersion": "0.99.1",
  "defaultProvider": "sub2api-deepseek",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "high",
  "defaultTools": ["+codemode", "-ls", "-grep", "-find"],
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-web-access",
    {
      "source": "npm:pi-subagents",
      "skills": ["!skills/council-mode"]
    },
    "npm:@aliou/pi-processes",
    "npm:@mrclrchtr/supi-context",
    "npm:pi-schedule-prompt",
    "https://github.com/sjet47/pi-setup",
    "https://github.com/sjet47/pi-intercom"
  ],
  "enabledModels": [
    "sub2api-openai/gpt-6-astra",
    "sub2api-deepseek/deepseek-flash",
    "sub2api-kimi/kimi-k3",
    "sub2api-grok/grok-4.7",
    "sub2api-openai/gpt-6-luna",
    "sub2api-openai/gpt-6-sol",
    "sub2api-grok/grok-4.7-build-fast",
    "magpie-anthropic/claude/claude-opus-5-5",
    "magpie-anthropic/claude/claude-fabel-5-1"
  ],
  "enableInstallTelemetry": false,
  "hideThinkingBlock": true,
  "showHardwareCursor": true,
  "editorPaddingX": 1,
  "collapseChangelog": true,
  "treeFilterMode": "user-only",
  "compaction": {
    "enabled": true
  },
  "theme": "dark",
  "pi-multicodex": {
    "usageMode": "left",
    "resetWindow": "7d",
    "showAccount": true,
    "showReset": false,
    "order": "account-first"
  },
  "powerline": {
    "preset": "default",
    "mouseScroll": true,
    "fixedEditor": true
  },
  "workingVibe": "startrek",
  "workingVibeMode": "file",
  "terminal": {
    "showTerminalProgress": true
  },
  "transport": "auto",
  "quietStartup": false,
  "doubleEscapeAction": "tree",
  "images": {
    "autoResize": false
  },
  "showCacheMissNotices": false,
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "always",
  "fullscreenExitOutput": "resume-hint",
  "outputPad": 1,
  "defaultProjectTrust": "always",
  "enableSkillCommands": false,
  "cacheWarming": "streaming",
  "markdown": {
    "mermaid": "streaming"
  },
  "fullscreenCopyOnSelect": true,
  "subagents": {
    "disableBuiltins": true
  }
}
