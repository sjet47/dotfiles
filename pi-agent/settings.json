{
  "lastChangelogVersion": "0.84.3",
  "defaultProvider": "sub2api-openai",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-web-access",
    "npm:pi-tps",
    "npm:@tintinweb/pi-subagents",
    "npm:@tifan/pi-recap",
    "npm:@tintinweb/pi-tasks",
    "npm:@aliou/pi-processes",
    "npm:@mrclrchtr/supi-context",
    "npm:pi-schedule-prompt",
    "https://github.com/sjet47/pi-setup",
    "npm:pi-readseek",
    "https://github.com/sjet47/pi-intercom"
  ],
  "enabledModels": [
    "sub2api-openai/gpt-5.6-sol",
    "sub2api-openai/deepseek-v4-flash",
    "sub2api-grok/grok-4.6",
    "sub2api-openai/gpt-5.6-luna",
    "sub2api-openai/kimi-k3",
    "sub2api-openai/deepseek-v4-flash-vision-exp",
    "sub2api-openai/GLM-5.3-Flash",
    "sub2api-openai/grok-4.6"
  ],
  "enableInstallTelemetry": false,
  "hideThinkingBlock": true,
  "showHardwareCursor": true,
  "editorPaddingX": 1,
  "collapseChangelog": true,
  "treeFilterMode": "user-only",
  "compaction": {
    "enabled": true
  },
  "theme": "dark",
  "pi-multicodex": {
    "usageMode": "left",
    "resetWindow": "7d",
    "showAccount": true,
    "showReset": false,
    "order": "account-first"
  },
  "powerline": {
    "preset": "default",
    "mouseScroll": true,
    "fixedEditor": true
  },
  "workingVibe": "startrek",
  "workingVibeMode": "file",
  "terminal": {
    "showTerminalProgress": true
  },
  "transport": "auto",
  "quietStartup": false,
  "doubleEscapeAction": "tree",
  "images": {
    "autoResize": false
  },
  "readseek": {
    "overrideTools": [
      "read",
      "edit",
      "write"
    ],
    "syntaxValidation": "off",
    "display": {
      "edit": "compact"
    }
  },
  "showCacheMissNotices": true,
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "fullscreenExitOutput": "resume-hint"
}